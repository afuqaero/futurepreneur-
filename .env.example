# Copy to .env.local for local Postgres testing, or set these in Vercel.
# Never commit real values.

# Neon pooled connection string (production). If omitted, the app uses SQLite locally.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Required on Vercel: long random value for signing CSRF tokens.
BIZREADY_CSRF_SECRET=replace-with-a-long-random-secret

# Production cookie and proxy behaviour.
BIZREADY_SECURE_COOKIES=1
BIZREADY_TRUST_PROXY=1

# Optional live AI provider. Without it the coach runs in labelled demo mode.
# BIZREADY_AI_KEY=
# BIZREADY_AI_BASE_URL=https://api.openai.com/v1
# BIZREADY_AI_MODEL=gpt-4o-mini
